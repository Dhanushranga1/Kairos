GROQ_API_KEY=your_key_here

# Jira Cloud (optional — leave unset to use mock data)
# JIRA_URL=https://your-org.atlassian.net
# JIRA_EMAIL=service-account@your-org.com
# JIRA_TOKEN=your_jira_api_token

# Microsoft Graph API (optional — leave unset to use mock data)
# GRAPH_TENANT_ID=your-azure-tenant-id
# GRAPH_CLIENT_ID=your-app-client-id
# GRAPH_CLIENT_SECRET=your-app-client-secret
# GRAPH_TEAM_ID=your-teams-team-id
# GRAPH_CHANNEL_IDS=channel-id-1,channel-id-2
# GRAPH_GROUP_ID=your-azure-ad-group-id
# GRAPH_MAILBOX_USER=pm@your-org.com
